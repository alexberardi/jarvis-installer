{
  "version": "2.0.0",
  "services": [
    {
      "id": "jarvis-config-service",
      "name": "Config Service",
      "description": "Centralized configuration and service discovery hub",
      "category": "core",
      "port": 7700,
      "image": "ghcr.io/alexberardi/jarvis-config-service:latest",
      "healthCheck": "/health",
      "dependsOn": ["postgres"],
      "database": "jarvis_config",
      "dbDriverPrefix": "postgresql://",
      "envVars": [
        { "name": "DATABASE_URL", "description": "PostgreSQL connection string", "required": true },
        { "name": "MIGRATIONS_DATABASE_URL", "description": "PostgreSQL URL for Alembic migrations", "required": true },
        { "name": "JARVIS_CONFIG_ADMIN_TOKEN", "description": "Admin token for write operations", "required": true, "secret": true, "secretRef": "JARVIS_CONFIG_ADMIN_TOKEN" },
        { "name": "JARVIS_AUTH_ADMIN_TOKEN", "description": "Token for auth admin endpoints", "required": true, "secret": true, "secretRef": "JARVIS_AUTH_ADMIN_TOKEN" },
        { "name": "JARVIS_AUTH_URL", "description": "Auth service URL", "required": false, "default": "http://jarvis-auth:8000" }
      ]
    },
    {
      "id": "jarvis-auth",
      "name": "Auth Service",
      "description": "JWT authentication with register, login, refresh, and logout",
      "category": "core",
      "port": 7701,
      "containerPort": 8000,
      "image": "ghcr.io/alexberardi/jarvis-auth:latest",
      "healthCheck": "/health",
      "dependsOn": ["postgres", "jarvis-config-service"],
      "database": "jarvis_auth",
      "dbDriverPrefix": "postgresql+psycopg2://",
      "envVars": [
        { "name": "DATABASE_URL", "description": "PostgreSQL connection string", "required": true },
        { "name": "AUTH_SECRET_KEY", "description": "JWT signing key", "required": true, "secret": true, "secretRef": "AUTH_SECRET_KEY" },
        { "name": "JARVIS_AUTH_ADMIN_TOKEN", "description": "Admin token for auth endpoints", "required": true, "secret": true, "secretRef": "JARVIS_AUTH_ADMIN_TOKEN" },
        { "name": "JARVIS_CONFIG_URL", "description": "Config service URL", "required": false, "default": "http://jarvis-config-service:7700" }
      ]
    },
    {
      "id": "jarvis-logs",
      "name": "Logging Service",
      "description": "Centralized logging for all Jarvis services via Loki",
      "category": "core",
      "port": 7702,
      "image": "ghcr.io/alexberardi/jarvis-logs:latest",
      "healthCheck": "/health",
      "dependsOn": ["loki", "jarvis-auth"],
      "envVars": [
        { "name": "LOKI_URL", "description": "Loki push endpoint", "required": true, "default": "http://loki:3100" },
        { "name": "JARVIS_CONFIG_URL", "description": "Config service URL", "required": false, "default": "http://jarvis-config-service:7700" }
      ]
    },
    {
      "id": "jarvis-command-center",
      "name": "Command Center",
      "description": "Central voice/command API, node management, and tool routing",
      "category": "core",
      "port": 7703,
      "containerPort": 8002,
      "image": "ghcr.io/alexberardi/jarvis-command-center:latest",
      "healthCheck": "/health",
      "dependsOn": ["postgres", "jarvis-auth", "jarvis-config-service"],
      "database": "jarvis_command_center",
      "dbDriverPrefix": "postgresql://",
      "volumes": ["command-center-prompt-providers:/app/core/prompt_providers_custom"],
      "llmInterfaceOptions": [
        { "id": "Qwen25MediumUntrained", "name": "Qwen 2.5 (7B-14B)", "description": "Recommended for Qwen 2.5 models", "default": true },
        { "id": "Qwen3LargeUntrained", "name": "Qwen 3 (14B-32B)", "description": "For Qwen 3 models with thinking support" },
        { "id": "HermesMediumUntrained", "name": "Hermes 3 (8B)", "description": "Hermes 3 Llama 8B Instruct" },
        { "id": "Llama31MediumUntrained", "name": "Llama 3.1 (8B)", "description": "Meta Llama 3.1 8B Instruct" },
        { "id": "Mistral7bMediumUntrained", "name": "Mistral 7B", "description": "Mistral 7B Instruct v0.3" },
        { "id": "Gemma2MediumUntrained", "name": "Gemma 2 (9B)", "description": "Google Gemma 2 9B IT" },
        { "id": "MixtralLargeUntrained", "name": "Mixtral 8x7B", "description": "Mixture-of-experts, needs ~26GB VRAM" },
        { "id": "LlamaSmallUntrained", "name": "Llama Small (1B-3B)", "description": "Optimized for very small models" }
      ],
      "modelPresets": [
        { "id": "qwen25-7b", "name": "Qwen 2.5 7B Instruct", "description": "Recommended for single GPU", "hfRepo": "Qwen/Qwen2.5-7B-Instruct", "modelName": ".models/Qwen2.5-7B-Instruct", "backend": "VLLM", "chatFormat": "qwen", "contextWindow": 32768, "interface": "Qwen25MediumUntrained", "vram": "~14GB" },
        { "id": "qwen25-14b", "name": "Qwen 2.5 14B Instruct", "description": "Higher quality, needs ~28GB", "hfRepo": "Qwen/Qwen2.5-14B-Instruct", "modelName": ".models/Qwen2.5-14B-Instruct", "backend": "VLLM", "chatFormat": "qwen", "contextWindow": 32768, "interface": "Qwen25MediumUntrained", "vram": "~28GB" },
        { "id": "qwen3-30b-gguf", "name": "Qwen3 30B-A3B GGUF", "description": "MoE, 3B active, fits single GPU", "hfRepo": "bartowski/Qwen_Qwen3-30B-A3B-GGUF", "modelName": ".models/Qwen3-30B-A3B-Q4_K_M/Qwen_Qwen3-30B-A3B-Q4_K_M.gguf", "backend": "GGUF", "chatFormat": "chatml", "contextWindow": 32768, "interface": "Qwen3LargeUntrained", "vram": "~19GB", "hfFilename": "Qwen_Qwen3-30B-A3B-Q4_K_M.gguf" },
        { "id": "llama31-8b", "name": "Llama 3.1 8B Instruct", "description": "128K context window", "hfRepo": "meta-llama/Llama-3.1-8B-Instruct", "modelName": ".models/Llama-3.1-8B-Instruct", "backend": "VLLM", "chatFormat": "llama3", "contextWindow": 131072, "interface": "Llama31MediumUntrained", "vram": "~16GB" },
        { "id": "hermes-8b", "name": "Hermes 3 Llama 8B", "description": "Function calling specialist", "hfRepo": "NousResearch/Hermes-3-Llama-3.1-8B", "modelName": ".models/Hermes-3-Llama-3.1-8B", "backend": "VLLM", "chatFormat": "chatml", "contextWindow": 32768, "interface": "HermesMediumUntrained", "vram": "~16GB" },
        { "id": "mistral-7b", "name": "Mistral 7B Instruct", "description": "Compact and fast", "hfRepo": "mistralai/Mistral-7B-Instruct-v0.3", "modelName": ".models/Mistral-7B-Instruct-v0.3", "backend": "VLLM", "chatFormat": "mistral", "contextWindow": 32768, "interface": "Mistral7bMediumUntrained", "vram": "~14GB" },
        { "id": "gemma2-9b", "name": "Gemma 2 9B IT", "description": "Google's instruction-tuned model", "hfRepo": "google/gemma-2-9b-it", "modelName": ".models/gemma-2-9b-it", "backend": "VLLM", "chatFormat": "chatml", "contextWindow": 8192, "interface": "Gemma2MediumUntrained", "vram": "~18GB" },
        { "id": "mixtral-gguf", "name": "Mixtral 8x7B GGUF", "description": "MoE, multi-GPU via llama.cpp", "hfRepo": "mradermacher/Mixtral-8x7B-Instruct-v0.1-GGUF", "modelName": ".models/Mixtral-8x7B-Instruct-v0.1.Q4_K_M.gguf", "backend": "GGUF", "chatFormat": "chatml", "contextWindow": 32768, "interface": "MixtralLargeUntrained", "vram": "~26GB", "hfFilename": "Mixtral-8x7B-Instruct-v0.1.Q4_K_M.gguf" }
      ],
      "envVars": [
        { "name": "DATABASE_URL", "description": "PostgreSQL connection string", "required": true },
        { "name": "ADMIN_API_KEY", "description": "Admin endpoint protection", "required": true, "secret": true, "secretRef": "ADMIN_API_KEY" },
        { "name": "JARVIS_CONFIG_URL", "description": "Config service URL", "required": false, "default": "http://jarvis-config-service:7700" }
      ]
    },
    {
      "id": "jarvis-whisper-api",
      "name": "Whisper STT",
      "description": "Speech-to-text via whisper.cpp (base.en model included)",
      "category": "recommended",
      "port": 7706,
      "image": "ghcr.io/alexberardi/jarvis-whisper-api:latest",
      "healthCheck": "/health",
      "dependsOn": ["postgres", "jarvis-auth", "jarvis-config-service"],
      "database": "jarvis_whisper",
      "dbDriverPrefix": "postgresql+psycopg2://",
      "gpu": true,
      "cpuFallback": true,
      "modelOptions": [
        { "id": "base.en", "name": "Base English", "size": "~140MB", "default": true, "builtin": true },
        { "id": "small.en", "name": "Small English", "size": "~460MB" },
        { "id": "medium.en", "name": "Medium English", "size": "~1.5GB" },
        { "id": "large-v3", "name": "Large v3 (Multilingual)", "size": "~3GB" }
      ],
      "envVars": [
        { "name": "DATABASE_URL", "description": "PostgreSQL connection string", "required": true },
        { "name": "JARVIS_CONFIG_URL", "description": "Config service URL", "required": false, "default": "http://jarvis-config-service:7700" }
      ]
    },
    {
      "id": "jarvis-tts",
      "name": "Text-to-Speech",
      "description": "Text-to-speech synthesis via Piper for voice responses",
      "category": "recommended",
      "port": 7707,
      "image": "ghcr.io/alexberardi/jarvis-tts:latest",
      "healthCheck": "/health",
      "dependsOn": ["jarvis-auth", "jarvis-config-service"],
      "envVars": [
        { "name": "JARVIS_CONFIG_URL", "description": "Config service URL", "required": false, "default": "http://jarvis-config-service:7700" }
      ]
    },
    {
      "id": "jarvis-llm-proxy-api",
      "name": "LLM Proxy",
      "description": "LLM inference backend (GGUF/vLLM)",
      "category": "core",
      "port": 7704,
      "image": "ghcr.io/alexberardi/jarvis-llm-proxy-api:latest",
      "healthCheck": "/health",
      "dependsOn": ["postgres", "redis", "jarvis-auth", "jarvis-config-service"],
      "database": "jarvis_llm_proxy",
      "dbDriverPrefix": "postgresql+psycopg2://",
      "gpu": true,
      "modelVolume": true,
      "envVars": [
        { "name": "DATABASE_URL", "description": "PostgreSQL connection string", "required": true },
        { "name": "MIGRATIONS_DATABASE_URL", "description": "PostgreSQL URL for Alembic", "required": true },
        { "name": "JARVIS_CONFIG_URL", "description": "Config service URL", "required": false, "default": "http://jarvis-config-service:7700" }
      ],
      "workers": [
        {
          "id": "llm-proxy-worker",
          "command": "python scripts/queue_worker.py",
          "envOverrides": {
            "LLM_PROXY_PROCESS_ROLE": "worker",
            "MODEL_SERVICE_URL": "http://jarvis-llm-proxy-api:7705"
          }
        }
      ]
    },
    {
      "id": "jarvis-notifications",
      "name": "Notifications",
      "description": "Push notifications, inbox, and device token management",
      "category": "recommended",
      "port": 7712,
      "image": "ghcr.io/alexberardi/jarvis-notifications:latest",
      "healthCheck": "/health",
      "dependsOn": ["postgres", "jarvis-auth", "jarvis-config-service"],
      "database": "jarvis_notifications",
      "dbDriverPrefix": "postgresql+psycopg2://",
      "envVars": [
        { "name": "DATABASE_URL", "description": "PostgreSQL connection string", "required": true },
        { "name": "NOTIFICATIONS_PORT", "description": "Server port", "required": false, "default": "7712" },
        { "name": "AUTH_SECRET_KEY", "description": "JWT signing key", "required": true, "secret": true, "secretRef": "AUTH_SECRET_KEY" },
        { "name": "ADMIN_API_KEY", "description": "Admin endpoint protection", "required": true, "secret": true, "secretRef": "ADMIN_API_KEY" },
        { "name": "JARVIS_CONFIG_URL", "description": "Config service URL", "required": false, "default": "http://jarvis-config-service:7700" }
      ]
    },
    {
      "id": "jarvis-settings-server",
      "name": "Settings Server",
      "description": "Runtime settings aggregator",
      "category": "core",
      "port": 7708,
      "image": "ghcr.io/alexberardi/jarvis-settings-server:latest",
      "healthCheck": "/health",
      "dependsOn": ["jarvis-auth", "jarvis-config-service"],
      "envVars": [
        { "name": "JARVIS_CONFIG_URL", "description": "Config service URL", "required": false, "default": "http://jarvis-config-service:7700" }
      ]
    },
    {
      "id": "jarvis-web",
      "name": "Web Chat",
      "description": "Web chat interface",
      "category": "recommended",
      "port": 7722,
      "image": "ghcr.io/alexberardi/jarvis-web:latest",
      "healthCheck": "/",
      "dependsOn": ["jarvis-auth", "jarvis-command-center"],
      "envVars": [
        { "name": "JARVIS_CONFIG_URL", "description": "Config service URL", "required": false, "default": "http://jarvis-config-service:7700" }
      ]
    },
    {
      "id": "jarvis-admin",
      "name": "Admin Dashboard",
      "description": "Web admin dashboard for managing services and settings",
      "category": "recommended",
      "port": 7711,
      "containerPort": 7711,
      "image": "ghcr.io/alexberardi/jarvis-admin:latest",
      "healthCheck": "/health",
      "dependsOn": ["jarvis-auth", "jarvis-config-service"],
      "envVars": [
        { "name": "JARVIS_CONFIG_URL", "description": "Config service URL", "required": false, "default": "http://jarvis-config-service:7700" },
        { "name": "JARVIS_COMPOSE_PATH", "description": "Where the host's docker-compose.yml + .env live (mounted into the container)", "required": false, "default": "/host/compose" }
      ],
      "volumes": [
        "/var/run/docker.sock:/var/run/docker.sock",
        "${HOME}/.jarvis/compose:/host/compose"
      ]
    }
  ],
  "infrastructure": [
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "description": "Primary database — stores users, commands, recipes, settings, and service config",
      "image": "postgres:16-alpine",
      "port": 5432,
      "envVars": [
        { "name": "POSTGRES_USER", "description": "Database superuser", "required": true, "default": "jarvis" },
        { "name": "POSTGRES_PASSWORD", "description": "Database password", "required": true, "secret": true, "secretRef": "POSTGRES_PASSWORD" },
        { "name": "POSTGRES_DB", "description": "Default database name", "required": true, "default": "jarvis_config" }
      ],
      "volumes": ["jarvis-postgres-data:/var/lib/postgresql/data"]
    },
    {
      "id": "redis",
      "name": "Redis",
      "description": "Task queue — used for long-running jobs like OCR processing and async pipelines",
      "image": "redis:7-alpine",
      "port": 6379,
      "envVars": [
        { "name": "REDIS_PASSWORD", "description": "Redis password", "required": true, "secret": true, "secretRef": "REDIS_PASSWORD" }
      ],
      "volumes": ["jarvis-redis-data:/data"]
    },
    {
      "id": "loki",
      "name": "Loki",
      "description": "Logging database — collects and indexes logs from all services",
      "image": "grafana/loki:2.9.0",
      "port": 3100,
      "envVars": [],
      "volumes": ["jarvis-loki-data:/loki"]
    },
    {
      "id": "grafana",
      "name": "Grafana",
      "description": "Monitoring dashboard — visualize logs and service health metrics",
      "image": "grafana/grafana:latest",
      "port": 3000,
      "envVars": [
        { "name": "GF_SECURITY_ADMIN_PASSWORD", "description": "Grafana admin password", "required": true, "default": "jarvis" }
      ],
      "volumes": ["jarvis-grafana-data:/var/lib/grafana"]
    },
    {
      "id": "mosquitto",
      "name": "Mosquitto",
      "description": "MQTT message broker for node communication",
      "image": "eclipse-mosquitto:2",
      "port": 1884,
      "envVars": [],
      "volumes": ["jarvis-mosquitto-data:/mosquitto/data"]
    }
  ]
}
